
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>FW Calculator</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Atturra-inspired light theme with high contrast */
    :root {
      --bg: #f5f7fb;          /* soft page background */
      --card: #ffffff;         /* card background */
      --ink: #1f2937;          /* primary text */
      --muted: #6b7280;        /* secondary text */
      --border: #e5e7eb;       /* subtle borders */
      --primary: #00a3ad;      /* Atturra teal */
      --primary-600: #008c95;  /* darker hover */
      --accent: #0b3c5d;       /* navy accent */
      --good: #16a34a;         /* green */
      --warn: #d97706;         /* amber */
      --bad: #dc2626;          /* red */
      --pill: #eef2f7;         /* light pill */
      --table-stripe: #fafbfe; /* zebra stripe */
    }

    html, body { height: 100%; }
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
    }
    .container-narrow { max-width: 1100px; }

    /* Cards */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: 0 6px 18px rgba(11, 60, 93, 0.06);
      color: var(--ink);
    }
    .card h5, .card h6 { color: #0f172a; }

    /* Buttons */
    .btn-accent {
      background: var(--primary);
      border: 1px solid var(--primary);
      color: #ffffff;
      font-weight: 700;
    }
    .btn-accent:hover { background: var(--primary-600); border-color: var(--primary-600); }
    .btn-outline-light { border-color: var(--accent); color: var(--accent); }
    .btn-outline-light:hover { background: var(--accent); color: #fff; }

    /* Form elements */
    label.form-label { font-weight: 600; color: #111827; }
    .form-control { color: var(--ink); background: #fff; border-color: var(--border); }
    .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 .2rem rgba(0,163,173,.15); }
    .form-check-input:checked { background-color: var(--primary); border-color: var(--primary); }

    /* Helpers */
    .pill { font-size: 12px; padding: 2px 10px; border-radius: 999px; background: var(--pill); color: var(--muted); border: 1px solid var(--border); }
    .dim { color: var(--muted); font-size: 0.92rem; }
    .metric { font-weight: 700; color: #0f172a; }
    .score-good { color: var(--good); }
    .score-mid { color: var(--warn); }
    .score-bad { color: var(--bad); }
    .badge-tier { border-radius: 12px; padding: 4px 10px; font-weight: 600; border: 1px solid var(--border); }
    .badge-best { background: rgba(0,163,173,0.12); color: var(--primary); border-color: rgba(0,163,173,0.35); }
    .badge-better { background: rgba(11,60,93,0.08); color: var(--accent); border-color: rgba(11,60,93,0.25); }
    .badge-good { background: rgba(217,119,6,0.10); color: var(--warn); border-color: rgba(217,119,6,0.30); }
    .link-like { color: var(--primary); text-decoration: none; cursor: pointer; }
    .link-like:hover { text-decoration: underline; }
    .sticky-top-ish { position: sticky; top: 1rem; z-index: 10; }
    .shadow-soft { box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
    details[open] summary::after { content: "▲"; margin-left: 8px; font-size: 0.8rem; color: var(--muted); }
    details summary::after { content: "▼"; margin-left: 8px; font-size: 0.8rem; color: var(--muted); }
    summary { cursor: pointer; }
    code { color: var(--accent); }

    /* Tables */
    table.table { color: var(--ink); }
    .table thead th { background: #f3f6fb; color: #0f172a; border-bottom: 1px solid var(--border); }
    .table tbody tr:nth-child(odd) { background: var(--table-stripe); }
    .table tbody tr:hover { background: #f0f7f9; }
  </style>
</head>
<body>
  <div class="container container-narrow py-4">
    <div class="d-flex align-items-start gap-3 flex-wrap mb-3">
      <div>
        <h1 class="h3 mb-1" style="color:#0b3c5d">Firewall‑as‑a‑Service (FWaaS) Calculator</h1>
        <div class="small-muted">Enter your requirements; we’ll amortize costs and recommend the best‑fit firewalls.</div>
      </div>
      <div class="ms-auto sticky-top-ish">
        <button id="resetBtn" class="btn btn-outline-light btn-sm">Reset</button>
      </div>
    </div>

    <!-- Inputs -->
    <div class="row g-3 mb-3">
      <div class="col-lg-6">
        <div class="card shadow-soft p-3 h-100">
          <h5 class="mb-3">Requirements</h5>
          <div class="row g-3">
            <div class="col-6">
              <label class="form-label">Total users</label>
              <input id="users" type="number" min="1" class="form-control" placeholder="e.g. 250" value="150" />
            </div>
            <div class="col-6">
              <label class="form-label">Total Internet bandwidth (Mbps)</label>
              <input id="bandwidth" type="number" min="10" step="10" class="form-control" placeholder="e.g. 500" value="500" />
            </div>
            <div class="col-6">
              <label class="form-label">Remote access VPN users (peak)</label>
              <input id="vpnUsers" type="number" min="0" class="form-control" placeholder="e.g. 50" value="50" />
            </div>
            <div class="col-6">
              <label class="form-label">IPSec site‑to‑site tunnels</label>
              <input id="ipsecTunnels" type="number" min="0" class="form-control" placeholder="e.g. 8" value="6" />
            </div>
          </div>
          <hr class="my-3" />
          <div class="row g-3">
            <div class="col-6 form-check">
              <input id="feat_url" class="form-check-input" type="checkbox" checked>
              <label class="form-check-label" for="feat_url">URL filtering</label>
            </div>
            <div class="col-6 form-check">
              <input id="feat_ssl" class="form-check-input" type="checkbox" checked>
              <label class="form-check-label" for="feat_ssl">SSL inspection</label>
            </div>
            <div class="col-6 form-check">
              <input id="feat_ids" class="form-check-input" type="checkbox" checked>
              <label class="form-check-label" for="feat_ids">IDS/IPS</label>
            </div>
            <div class="col-6 form-check">
              <input id="feat_managed" class="form-check-input" type="checkbox" checked>
              <label class="form-check-label" for="feat_managed">Managed (FWaaS)</label>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="card shadow-soft p-3 h-100">
          <h5 class="mb-3">Quote & Amortization</h5>
          <div class="row g-3">
            <div class="col-6">
              <label class="form-label">Hardware / License cost (AUD)</label>
              <input id="hwCost" type="number" min="0" class="form-control" placeholder="e.g. 12000" value="12000" />
            </div>
            <div class="col-6">
              <label class="form-label">Setup / Install cost (AUD)</label>
              <input id="setupCost" type="number" min="0" class="form-control" placeholder="e.g. 2500" value="2500" />
            </div>
            <div class="col-4">
              <label class="form-label">Annual interest %</label>
              <input id="apr" type="number" min="0" step="0.1" class="form-control" placeholder="e.g. 6" value="5" />
            </div>
            <div class="col-4">
              <label class="form-label">Term (years)</label>
              <input id="termYears" type="number" min="1" class="form-control" placeholder="e.g. 3" value="3" />
            </div>
            <div class="col-4">
              <label class="form-label">Ongoing support (monthly)</label>
              <input id="supportMonthly" type="number" min="0" class="form-control" placeholder="e.g. 450" value="450" />
            </div>
          </div>
          <div class="mt-3 small-muted">Amortization uses standard loan formula. If APR = 0, we split costs equally.</div>
          <div class="mt-3"><button id="calcBtn" class="btn btn-accent w-100">Calculate & Match</button></div>
        </div>
      </div>
    </div>

    <!-- Results / Summary -->
    <div class="row g-3 mb-4">
      <div class="col-lg-5">
        <div class="card shadow-soft p-3 h-100">
          <h5 class="mb-2">Monthly Cost Summary</h5>
          <div class="d-flex flex-column gap-2" id="summary">
            <div><span class="dim">Amortized hardware</span> <span class="float-end metric" id="sum_hw">—</span></div>
            <div><span class="dim">Amortized setup</span> <span class="float-end metric" id="sum_setup">—</span></div>
            <div><span class="dim">Ongoing support</span> <span class="float-end metric" id="sum_support">—</span></div>
            <hr/>
            <div><span class="dim">Estimated FWaaS monthly</span> <span class="float-end metric" id="sum_total">—</span></div>
          </div>
          <details class="mt-3">
            <summary>Show formula</summary>
            <div class="small-muted mt-2">
              MonthlyPayment = <code>P * r / (1 - (1 + r)^(-n))</code>, where
              <ul>
                <li><code>P</code> is principal (hardware or setup)</li>
                <li><code>r</code> is monthly interest (APR/12)</li>
                <li><code>n</code> is term in months</li>
              </ul>
            </div>
          </details>
        </div>
      </div>
      <div class="col-lg-7">
        <div class="card shadow-soft p-3 h-100">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h5 class="mb-0">Recommendations</h5>
            <span class="pill">Auto‑matched to your requirements</span>
          </div>
          <div id="recs" class="vstack gap-3"></div>
        </div>
      </div>
    </div>

    <!-- Catalog -->
    <div class="card shadow-soft p-3 mb-4">
      <div class="d-flex align-items-center justify-content-between">
        <h5 class="mb-0">Firewall Catalog</h5>
        <span class="small-muted">You can edit and re‑run matching</span>
      </div>
      <div class="table-responsive mt-3">
        <table class="table table-striped align-middle" id="catalogTable">
          <thead>
            <tr>
              <th>Vendor</th>
              <th>Model</th>
              <th>Max Users</th>
              <th>Throughput (Gbps)</th>
              <th>SSL/TLS (Gbps)</th>
              <th>VPN Users</th>
              <th>IPSec Tunnels</th>
              <th>Features</th>
              <th>Base Monthly (AUD)</th>
              <th>Setup (AUD)</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="catalogBody"></tbody>
        </table>
      </div>
      <details class="mt-2">
        <summary>Add / Replace catalog (JSON)</summary>
        <div class="row g-2 mt-2">
          <div class="col-12">
            <textarea id="catalogJson" rows="10" class="form-control" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;"></textarea>
          </div>
          <div class="col-12 d-flex gap-2">
            <button id="applyCatalog" class="btn btn-outline-light">Apply JSON</button>
            <a id="downloadCatalog" class="btn btn-outline-light" download="firewall_catalog.json">Download JSON</a>
          </div>
        </div>
      </details>
    </div>

    <div class="small-muted">Note: Specs and prices below are example placeholders for modeling only — replace with your catalog values.</div>
  </div>

  <script>
    // ===== Amortization =====
    function amortize(principal, annualRate, years) {
      const monthlyRate = (annualRate / 100) / 12;
      const n = years * 12;
      if (!principal || principal <= 0 || !n) return 0;
      if (monthlyRate === 0) return principal / n;
      return principal * monthlyRate / (1 - Math.pow(1 + monthlyRate, -n));
    }

    // ===== Catalog (sample data; replace with your truth source) =====
    const defaultCatalog = [
      {
        vendor: 'Fortinet', model: 'FortiGate 100F',
        maxUsers: 600, throughputGbps: 10, sslGbps: 1.2, vpnUsers: 200, ipsecTunnels: 200,
        features: { urlFiltering: true, sslInspection: true, idsIps: true, managedAvailable: true },
        baseMonthly: 850, setup: 1800
      },
      {
        vendor: 'Palo Alto', model: 'PA-3220',
        maxUsers: 1000, throughputGbps: 15.2, sslGbps: 2.0, vpnUsers: 400, ipsecTunnels: 400,
        features: { urlFiltering: true, sslInspection: true, idsIps: true, managedAvailable: true },
        baseMonthly: 1400, setup: 2400
      },
      {
        vendor: 'Sophos', model: 'XGS 3300',
        maxUsers: 500, throughputGbps: 34.9, sslGbps: 1.1, vpnUsers: 300, ipsecTunnels: 200,
        features: { urlFiltering: true, sslInspection: true, idsIps: true, managedAvailable: true },
        baseMonthly: 780, setup: 1600
      },
      {
        vendor: 'Cisco', model: 'Secure Firewall 1120',
        maxUsers: 250, throughputGbps: 2.5, sslGbps: 0.7, vpnUsers: 100, ipsecTunnels: 50,
        features: { urlFiltering: true, sslInspection: true, idsIps: true, managedAvailable: true },
        baseMonthly: 520, setup: 1400
      },
      {
        vendor: 'WatchGuard', model: 'Firebox M390',
        maxUsers: 700, throughputGbps: 18, sslGbps: 1.3, vpnUsers: 300, ipsecTunnels: 250,
        features: { urlFiltering: true, sslInspection: true, idsIps: true, managedAvailable: true },
        baseMonthly: 930, setup: 2000
      },
      {
        vendor: 'Fortinet', model: 'FortiGate 60F',
        maxUsers: 100, throughputGbps: 10, sslGbps: 0.75, vpnUsers: 50, ipsecTunnels: 20,
        features: { urlFiltering: true, sslInspection: true, idsIps: true, managedAvailable: true },
        baseMonthly: 220, setup: 900
      }
    ];

    let catalog = JSON.parse(localStorage.getItem('fwaas_catalog') || 'null') || defaultCatalog;

    function saveCatalog() {
      localStorage.setItem('fwaas_catalog', JSON.stringify(catalog, null, 2));
    }

    function currency(n) { return n ? `A$${n.toFixed(2)}` : 'A$0.00'; }

    function renderCatalog() {
      const body = document.getElementById('catalogBody');
      body.innerHTML = '';
      catalog.forEach((c, i) => {
        const tr = document.createElement('tr');
        const feats = [];
        if (c.features?.urlFiltering) feats.push('URL');
        if (c.features?.sslInspection) feats.push('SSL');
        if (c.features?.idsIps) feats.push('IDS/IPS');
        if (c.features?.managedAvailable) feats.push('Managed');
        tr.innerHTML = `
          <td>${c.vendor}</td>
          <td>${c.model}</td>
          <td>${c.maxUsers}</td>
          <td>${c.throughputGbps}</td>
          <td>${c.sslGbps}</td>
          <td>${c.vpnUsers}</td>
          <td>${c.ipsecTunnels}</td>
          <td>${feats.join(', ')}</td>
          <td>${currency(c.baseMonthly)}</td>
          <td>${currency(c.setup)}</td>
          <td><a class="link-like" data-idx="${i}" onclick="prefillFromCatalog(${i})">Use quote</a></td>
        `;
        body.appendChild(tr);
      });

      // JSON panel setup
      const json = document.getElementById('catalogJson');
      json.value = JSON.stringify(catalog, null, 2);
      const dl = document.getElementById('downloadCatalog');
      const blob = new Blob([json.value], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      dl.href = url;
    }

    function prefillFromCatalog(i) {
      const item = catalog[i];
      if (!item) return;
      // Prefill costs (illustrative heuristic; adjust to your pricing model)
      document.getElementById('hwCost').value = Math.round((item.baseMonthly * 24)); // assume ~24mo value
      document.getElementById('setupCost').value = item.setup || 0;
      document.getElementById('supportMonthly').value = Math.round(item.baseMonthly * 0.6 + 200); // managed uplift example
      // Re-run calc
      runCalc();
      // Scroll to summary
      document.getElementById('sum_total').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // ===== Matching Logic =====
    function computeRequiredThroughputMbps(inputs) {
      const { bandwidth, feat_ssl, feat_url, feat_ids } = inputs;
      let factor = 1.0;
      if (feat_ssl) factor *= 1.5;    // SSL/TLS inspection tax
      if (feat_url) factor *= 1.15;   // URL filtering tax
      if (feat_ids) factor *= 1.35;   // IDS/IPS tax
      return bandwidth * factor;
    }

    function meetsMinimums(c, inputs) {
      const reqTpGbps = computeRequiredThroughputMbps(inputs) / 1000; // Mbps -> Gbps
      const tpOk = c.throughputGbps >= reqTpGbps * 1.10; // require 10% headroom
      const sslOk = !inputs.feat_ssl || c.sslGbps >= (reqTpGbps * 0.8); // looser for SSL spec baselines
      const usersOk = c.maxUsers >= inputs.users * 1.1; // 10% headroom
      const vpnOk = c.vpnUsers >= inputs.vpnUsers;
      const tunnelsOk = c.ipsecTunnels >= inputs.ipsecTunnels;
      const urlOk = !inputs.feat_url || c.features?.urlFiltering;
      const idsOk = !inputs.feat_ids || c.features?.idsIps;
      const sslFeatOk = !inputs.feat_ssl || c.features?.sslInspection;
      const managedOk = !inputs.feat_managed || c.features?.managedAvailable;
      return tpOk && sslOk && usersOk && vpnOk && tunnelsOk && urlOk && idsOk && sslFeatOk && managedOk;
    }

    function scoreCandidate(c, inputs) {
      const reqTpGbps = computeRequiredThroughputMbps(inputs) / 1000;
      const tpHeadroom = Math.max(0, (c.throughputGbps - reqTpGbps) / Math.max(0.001, reqTpGbps));
      const userHeadroom = Math.max(0, (c.maxUsers - inputs.users) / Math.max(1, inputs.users));
      const vpnHeadroom = Math.max(0, (c.vpnUsers - inputs.vpnUsers) / Math.max(1, inputs.vpnUsers));
      const tunnelHeadroom = Math.max(0, (c.ipsecTunnels - inputs.ipsecTunnels) / Math.max(1, inputs.ipsecTunnels));

      const price = (c.baseMonthly || 0) + (c.setup || 0) / 24; // normalize setup across ~24 months

      // Feature coverage bonus
      let featScore = 0;
      if (inputs.feat_url && c.features?.urlFiltering) featScore += 0.5;
      if (inputs.feat_ssl && c.features?.sslInspection) featScore += 0.6;
      if (inputs.feat_ids && c.features?.idsIps) featScore += 0.6;
      if (inputs.feat_managed && c.features?.managedAvailable) featScore += 0.4;

      // Weighted scoring (tune as needed)
      const score = (
        tpHeadroom * 3.0 +
        userHeadroom * 1.6 +
        vpnHeadroom * 0.8 +
        tunnelHeadroom * 0.6 +
        featScore * 1.2
      ) - (price / 3000); // price penalty scaling

      return score;
    }

    function rankMatches(inputs) {
      const candidates = catalog.filter(c => meetsMinimums(c, inputs));
      const ranked = candidates
        .map(c => ({ c, score: scoreCandidate(c, inputs) }))
        .sort((a, b) => b.score - a.score);
      return ranked.slice(0, 5); // top 5
    }

    function tierLabel(idx) {
      if (idx === 0) return '<span class="badge-tier badge-best">Best fit</span>';
      if (idx <= 2) return '<span class="badge-tier badge-better">Better option</span>';
      return '<span class="badge-tier badge-good">Good alternative</span>';
    }

    function renderRecs(ranked) {
      const recs = document.getElementById('recs');
      recs.innerHTML = '';
      if (!ranked.length) {
        recs.innerHTML = '<div class="small-muted">No exact matches. Try relaxing one or more requirements, or expand the catalog.</div>';
        return;
      }
      ranked.forEach((r, idx) => {
        const { c, score } = r;
        const div = document.createElement('div');
        const scoreClass = score > 2 ? 'score-good' : score > 1 ? 'score-mid' : 'score-bad';
        const feats = [];
        if (c.features?.urlFiltering) feats.push('URL');
        if (c.features?.sslInspection) feats.push('SSL');
        if (c.features?.idsIps) feats.push('IDS/IPS');
        if (c.features?.managedAvailable) feats.push('Managed');
        div.className = 'p-3 rounded border';
        div.innerHTML = `
          <div class="d-flex align-items-start gap-2">
            <div class="flex-grow-1">
              <div class="d-flex align-items-center gap-2">
                <h6 class="mb-0">${c.vendor} ${c.model}</h6>
                ${tierLabel(idx)}
              </div>
              <div class="small-muted">Score: <span class="${scoreClass}">${score.toFixed(2)}</span> · Features: ${feats.join(', ') || '—'}</div>
              <div class="mt-2 row g-2">
                <div class="col-6 col-md-3">Users ≤ <strong>${c.maxUsers}</strong></div>
                <div class="col-6 col-md-3">TP <strong>${c.throughputGbps} Gbps</strong></div>
                <div class="col-6 col-md-3">SSL <strong>${c.sslGbps} Gbps</strong></div>
                <div class="col-6 col-md-3">VPN Users <strong>${c.vpnUsers}</strong></div>
                <div class="col-6 col-md-3">IPSec <strong>${c.ipsecTunnels}</strong></div>
                <div class="col-6 col-md-3">Base Monthly <strong>${currency(c.baseMonthly)}</strong></div>
                <div class="col-6 col-md-3">Setup <strong>${currency(c.setup)}</strong></div>
              </div>
            </div>
            <div class="text-end">
              <button class="btn btn-sm btn-outline-light" onclick='prefillFromCatalog(${catalog.indexOf(c)})'>Use this for quote</button>
            </div>
          </div>
        `;
        recs.appendChild(div);
      });
    }

    // ===== Calculator Orchestration =====
    function gatherInputs() {
      return {
        users: Number(document.getElementById('users').value || 0),
        bandwidth: Number(document.getElementById('bandwidth').value || 0),
        vpnUsers: Number(document.getElementById('vpnUsers').value || 0),
        ipsecTunnels: Number(document.getElementById('ipsecTunnels').value || 0),
        feat_url: document.getElementById('feat_url').checked,
        feat_ssl: document.getElementById('feat_ssl').checked,
        feat_ids: document.getElementById('feat_ids').checked,
        feat_managed: document.getElementById('feat_managed').checked,
        hwCost: Number(document.getElementById('hwCost').value || 0),
        setupCost: Number(document.getElementById('setupCost').value || 0),
        apr: Number(document.getElementById('apr').value || 0),
        termYears: Number(document.getElementById('termYears').value || 0),
        supportMonthly: Number(document.getElementById('supportMonthly').value || 0)
      };
    }

    function runCalc() {
      const x = gatherInputs();
      // Amortization parts
      const mHw = amortize(x.hwCost, x.apr, x.termYears);
      const mSetup = amortize(x.setupCost, x.apr, x.termYears);
      const total = mHw + mSetup + x.supportMonthly;
      document.getElementById('sum_hw').textContent = currency(mHw);
      document.getElementById('sum_setup').textContent = currency(mSetup);
      document.getElementById('sum_support').textContent = currency(x.supportMonthly);
      document.getElementById('sum_total').textContent = currency(total);

      // Matching
      const ranked = rankMatches(x);
      renderRecs(ranked);
    }

    // ===== Events =====
    document.getElementById('calcBtn').addEventListener('click', runCalc);
    document.getElementById('resetBtn').addEventListener('click', () => {
      localStorage.removeItem('fwaas_catalog');
      catalog = JSON.parse(JSON.stringify(defaultCatalog));
      renderCatalog();
      runCalc();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    document.getElementById('applyCatalog').addEventListener('click', () => {
      try {
        const parsed = JSON.parse(document.getElementById('catalogJson').value);
        if (!Array.isArray(parsed)) throw new Error('Catalog JSON must be an array of firewall objects');
        catalog = parsed;
        saveCatalog();
        renderCatalog();
        runCalc();
      } catch (e) {
        alert('Invalid JSON: ' + e.message);
      }
    });

    // Initial render
    renderCatalog();
    runCalc();
  </script>
